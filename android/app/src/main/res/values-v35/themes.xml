<?xml version="1.0" encoding="utf-8"?>
<!-- Android 15 (API 35) : l'affichage edge-to-edge devient OBLIGATOIRE au
     premier plan pour les apps ciblant 35. Les écrans simples de SwarmGlu
     (tableau de bord scolaire, lisibilité en lumière de classe) préfèrent
     les barres système classiques : opt-out documenté, évalué pour
     targetSdk 36 où le flag sera ignoré. -->
<resources>
    <style name="Theme.SwarmGlu" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/swarm_primary</item>
        <item name="colorPrimaryDark">@color/swarm_primary_dark</item>
        <item name="colorAccent">@color/swarm_accent</item>
        <item name="android:windowBackground">#111418</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
