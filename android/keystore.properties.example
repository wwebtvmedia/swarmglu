# Modèle — copier vers android/keystore.properties et remplir.
# Générer une clé : keytool -genkeypair -v -keystore swarmglu-release.keystore \
#   -alias swarmglu -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
storeFile=swarmglu-release.keystore
storePassword=MOT_DE_PASSE
keyAlias=swarmglu
keyPassword=MOT_DE_PASSE
